<?xml version="1.0"?>
<ruleset name="WC-MNM-Quickview">
	<description>Mix and Match Quickview coding standard, based on Mix and Match core's.</description>

	<!-- Check the plugin, not its dependencies. -->
	<file>.</file>
	<exclude-pattern>*/.claude/*</exclude-pattern>
	<exclude-pattern>*/bin/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/deploy/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/vendor-prefixed/*</exclude-pattern>

	<!-- Only check PHP files. -->
	<arg name="extensions" value="php"/>

	<!-- Configs -->
	<config name="minimum_supported_wp_version" value="6.5" />
	<config name="testVersion" value="8.0-" />

	<!-- Rules -->
	<rule ref="WordPress-Extra">
		<exclude name="Generic.Files.LineEndings.InvalidEOLChar" />
		<exclude name="Squiz.Commenting.FunctionComment" />
	</rule>

	<rule ref="WooCommerce-Core">
		<exclude name="Core.Commenting.CommentTags.AuthorTag" />
		<exclude name="WooCommerce.Commenting.CommentHooks" />
		<exclude name="Generic.Arrays.DisallowShortArraySyntax" />
		<exclude name="Generic.Commenting.DocComment.SpacingAfter" />
		<exclude name="Generic.Files.LineEndings.InvalidEOLChar" />
		<exclude name="Squiz.Commenting" />
		<exclude name="WordPress.Files.FileName" />
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="wc-mnm-quickview"/>
			</property>
		</properties>
	</rule>

	<rule ref="PHPCompatibilityWP" />
</ruleset>
